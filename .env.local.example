# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by create-next-app's default .gitignore -- verify before committing anything.

# Supabase project settings -> API. The URL and anon key are safe to expose
# to the browser (that's what NEXT_PUBLIC_ means). The service role key is
# NOT -- it bypasses Row Level Security entirely. Never prefix it with
# NEXT_PUBLIC_, never log it, never put it in client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud project -> Settings -> Keys. Server-only, used to create
# video rooms and access tokens from a Next.js route handler.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Random 32+ byte secret used to sign the short-lived patient lookup session
# (patients have no Supabase Auth account in v1, see DATA-MODEL.md). Generate
# with: openssl rand -base64 32
PATIENT_SESSION_SECRET=

# console.anthropic.com -> API Keys. Powers the AI qualification chat
# (src/app/api/assistant/chat/route.ts). Server-only.
ANTHROPIC_API_KEY=
